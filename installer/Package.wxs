<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="MdExplorerPreview"
    Manufacturer="$(var.ProductManufacturer)"
    Version="$(var.ProductVersion)"
    UpgradeCode="$(var.ProductUpgradeCode)"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="NETFRAMEWORK48_RELEASE">
      <RegistrySearch
        Id="NetFramework48ReleaseSearch"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
        Name="Release"
        Type="raw" />
    </Property>

    <Launch Condition="Installed OR NETFRAMEWORK48_RELEASE &gt;= &quot;#528040&quot;" Message="Microsoft .NET Framework 4.8 or later is required." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MdExplorerPreview" />
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="MdExplorerPreview" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Binary Id="SetupCustomActions" SourceFile="$(var.CustomActionOutputDir)MdExplorerPreview.Setup.CustomActions.CA.dll" />

    <CustomAction Id="StopProcessesBeforeInstall" BinaryRef="SetupCustomActions" DllEntry="StopRunningProcesses" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="StopProcessesBeforeRemove" BinaryRef="SetupCustomActions" DllEntry="StopRunningProcesses" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveLegacyCurrentUserArtifacts" BinaryRef="SetupCustomActions" DllEntry="RemoveLegacyCurrentUserArtifacts" Execute="immediate" Return="ignore" />
    <CustomAction Id="RegisterPreviewHandler" BinaryRef="SetupCustomActions" DllEntry="RegisterPreviewHandler" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UnregisterPreviewHandler" BinaryRef="SetupCustomActions" DllEntry="UnregisterPreviewHandler" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="LaunchAutoUnblocker" BinaryRef="SetupCustomActions" DllEntry="LaunchAutoUnblocker" Execute="immediate" Return="ignore" />

    <SetProperty Id="StopProcessesBeforeInstall" Before="StopProcessesBeforeInstall" Sequence="execute" Value="InstallFolder=[INSTALLFOLDER]" />
    <SetProperty Id="StopProcessesBeforeRemove" Before="StopProcessesBeforeRemove" Sequence="execute" Value="InstallFolder=[INSTALLFOLDER]" />
    <SetProperty Id="RegisterPreviewHandler" Before="RegisterPreviewHandler" Sequence="execute" Value="InstallFolder=[INSTALLFOLDER]" />
    <SetProperty Id="UnregisterPreviewHandler" Before="UnregisterPreviewHandler" Sequence="execute" Value="InstallFolder=[INSTALLFOLDER]" />

    <InstallExecuteSequence>
      <Custom Action="StopProcessesBeforeInstall" Before="InstallFiles" Condition="NOT Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveLegacyCurrentUserArtifacts" Before="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterPreviewHandler" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StopProcessesBeforeRemove" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterPreviewHandler" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="LaunchAutoUnblocker" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel &gt;= 3" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <Component Id="cmpHandlerAssembly" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filHandlerAssembly" Source="$(var.HandlerOutputDir)\MdExplorerPreview.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpMarkdig" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filMarkdig" Source="$(var.HandlerOutputDir)\Markdig.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpSharpShell" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filSharpShell" Source="$(var.HandlerOutputDir)\SharpShell.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpSystemBuffers" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filSystemBuffers" Source="$(var.HandlerOutputDir)\System.Buffers.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpSystemMemory" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filSystemMemory" Source="$(var.HandlerOutputDir)\System.Memory.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpSystemNumericsVectors" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filSystemNumericsVectors" Source="$(var.HandlerOutputDir)\System.Numerics.Vectors.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpSystemUnsafe" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filSystemUnsafe" Source="$(var.HandlerOutputDir)\System.Runtime.CompilerServices.Unsafe.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpAutoUnblockerExe" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filAutoUnblockerExe" Source="$(var.AutoUnblockerOutputDir)\MdExplorerPreview.AutoUnblocker.exe" KeyPath="yes" />
      </Component>

      <Component Id="cmpAutoUnblockerConfig" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filAutoUnblockerConfig" Source="$(var.AutoUnblockerOutputDir)\MdExplorerPreview.AutoUnblocker.exe.config" KeyPath="yes" />
      </Component>

      <Component Id="cmpNewtonsoftJson" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <File Id="filNewtonsoftJson" Source="$(var.AutoUnblockerOutputDir)\Newtonsoft.Json.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmpAutoUnblockerRun" Directory="INSTALLFOLDER" Bitness="always64" Guid="*">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
          Name="MdExplorerPreview Auto-Unblocker"
          Value="&quot;[INSTALLFOLDER]MdExplorerPreview.AutoUnblocker.exe&quot;"
          Type="string"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
